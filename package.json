{
  "name": "holy-songs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "vite",
    "dev:backend": "python3 -m backend.main",
    "build:songs": "tsx scripts/build-songs.ts",
    "build:app": "vite build",
    "build": "npm run build:songs && npm run build:app",
    "deploy:nomad": "./scripts/deploy-nomad.sh",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/lib/*.test.ts src/live/*.test.ts scripts/*.test.ts"
  },
  "dependencies": {
    "fuse.js": "^7.0.0",
    "nanostores": "^1.4.2"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^7.3.6"
  }
}
